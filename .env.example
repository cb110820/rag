# 模型提供方：openai（值用 openai:model-name）或 dashscope（阿里云原生）
MODEL_PROVIDER=openai
MODEL=openai:gpt-5.5
OPENAI_API_KEY=
# openai 提供方可指向兼容端点
# OPENAI_BASE_URL=http://localhost:11434/v1
# dashscope 提供方需要的密钥（部分密钥仅原生端点授权，不支持兼容模式）
# DASHSCOPE_API_KEY=
# MODEL=qwen-plus

KNOWLEDGE_DIR=data/knowledge
# 员工技能（Agent Skills）根目录，每个技能一个含 SKILL.md 的子目录
SKILLS_DIR=skills
# 嵌入/重排提供方：生产用 bge-m3 / bge-reranker-v2-m3；本地免下载用 hash / none
RAG_EMBEDDING=bge-m3
RAG_RERANKER=bge-reranker-v2-m3
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 语料块嵌入向量缓存（SQLite），新增文件时只嵌入新块、重启后免重新嵌入
# EMBEDDING_CACHE_PATH=.cache/embeddings.sqlite3
RAG_TOP_K=6
RAG_TIMEOUT_SECONDS=30
RAG_MAX_RETRIES=3
# Comma-separated virtual files loaded by DeepAgents through the memory parameter.
MEMORY_FILES=

# ── 持久化后端（生产部署切 postgres；本地开发默认 sqlite） ────────
# sqlite：账号/checkpoint/长期记忆全部存于 DATA_DIR/app.db（单机、WAL）
# postgres：三类数据走独立 psycopg 异步连接池（多副本/高可用/可备份）
STORAGE_BACKEND=sqlite
# STORAGE_BACKEND=postgres 时必填（psycopg 连接串，非 SQLAlchemy 语法）：
#   本地 docker compose：postgresql://rag:rag@localhost:5432/rag
#   生产云数据库：postgresql://user:pwd@host:5432/db?sslmode=require
# POSTGRES_DSN=postgresql://rag:rag@localhost:5432/rag
# 业务/saver/store 各一个连接池，按副本数与 PG max_connections 调整
PG_POOL_MIN=1
PG_POOL_MAX=10

# ── 长期记忆治理（写 /memory/ 时的强制护栏，模型 prompt 之外的硬限制） ──
# 单个记忆文件最大字节数（默认 8KB，防止画像无限膨胀吃掉上下文）
MEMORY_MAX_FILE_BYTES=8192
# 每用户画像记忆条目数上限
MEMORY_MAX_ITEMS=20

# ── 语义事实记忆（save_memory / recall_memories / forget_memory） ──
# 向量嵌入来源：留空跟随 RAG_EMBEDDING；可独立设为 bge-m3 / hash / none。
# none 时不建向量索引（无需 sqlite-vec/pgvector），召回退化为应用层关键词打分。
MEMORY_EMBEDDING=
# 每次召回条数；低于该相似度（cosine，0~1）的命中作为噪声丢弃
MEMORY_RECALL_TOP_K=5
MEMORY_RECALL_MIN_SCORE=0.2
# 单条事实最大字符数、每用户 active 事实条目上限、语义去重相似度阈值（≥ 则建立取代链）
MEMORY_FACT_MAX_CHARS=1000
MEMORY_FACT_MAX_ITEMS=200
MEMORY_DEDUP_THRESHOLD=0.9
# 事实默认保留天数：0 表示不过期；save_memory 也可按条目显式传 ttl_days
MEMORY_DEFAULT_TTL_DAYS=0
# 被新事实取代（superseded）的旧版本审计保留天数，到期由 TTL sweeper 物理清除
MEMORY_SUPERSEDED_TTL_DAYS=14
# 记忆 Store 操作的超时（秒）与失败重试次数（生产红线：工具必须有超时重试）
MEMORY_TIMEOUT_SECONDS=10
MEMORY_MAX_RETRIES=2
# 长会话自动压缩：超过触发 token 数时摘要旧消息，仅保留最近 N 条原文
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_TRIGGER_TOKENS=6000
MEMORY_SUMMARY_KEEP_MESSAGES=20
# TTL 后台清扫间隔（分钟）：物理删除过期事实，日级 TTL 下即最大过期滞留时间
TTL_SWEEP_INTERVAL_MINUTES=60

# ── PostgreSQL 备份 / PITR（仅 STORAGE_BACKEND=postgres 时使用） ──
# 逻辑备份：python scripts/backup_postgres.py（--keep 控制轮转份数）
# 物理基准备份（PITR）：python scripts/backup_postgres.py --mode base
# 恢复：python scripts/restore_postgres.py <file.dump> --yes
# PITR 指引：python scripts/restore_postgres.py --pitr-guide

# ── LangSmith 可观测性（DeepAgents 原生支持，生产建议开启） ──
# 留空即不上报；打开后可追踪每次规划/委托/检索/记忆工具调用链
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=rag-deepagents
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── 账户与多用户记忆（生产级） ────────────────────────────────────
# 业务数据根目录：账号、refresh token、会话元数据、LangGraph checkpoint、
# 每用户长期记忆（sqlite 后端时全部存于 DATA_DIR/app.db，WAL 模式）
DATA_DIR=.data
# JWT 签名密钥：生产/多副本部署必须显式配置（建议 ≥32 字节随机串）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空时首次启动自动生成并写入 DATA_DIR/.jwt_secret（仅适合单机部署，
# 多副本不互认、删除文件后所有已签发令牌立即失效）
JWT_SECRET_KEY=
# access token 有效期（分钟，1~1440）；refresh token 有效期（天，1~365）
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
# 是否开放邮箱自助注册；关闭后只能由管理员直接写库建号
ALLOW_REGISTRATION=true

